<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrafficScope.Setup</RootNamespace>
    <AssemblyName>TrafficScope-Setup</AssemblyName>
    <AssemblyTitle>TrafficScope Setup</AssemblyTitle>
    <ApplicationIcon>..\TrafficScope.App\Resources\AppIcon.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <!-- The app exe is embedded at publish time: dotnet publish -p:PayloadPath=... -->
  <ItemGroup Condition="'$(PayloadPath)' != ''">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="payload.exe" />
  </ItemGroup>
</Project>
